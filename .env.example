# ---- Drex (required for live bots) ----
DREX_API_KEY=
DREX_URL=https://drex.nace.ai/v1/systemone
DREX_MODEL=drex-latest
DREX_PRICE_PER_M_INPUT=0.05
DREX_TIMEOUT=3

# ---- LLM "Giant" for the benchmark (either one) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# LLM_MODEL=claude-sonnet-5-5
# LLM_PRICE_IN=3.0
# LLM_PRICE_OUT=15.0

# ---- NDI (hand-history upload) ----
NDI_API_KEY=
# NDI_BASE_URL=https://ndi-api.nace.ai

# ---- tuning ----
MANIP_BLUFF_THRESHOLD=0.5
MC_RUNS=300
PORT=5050

# ---- public hosting (Render etc.) ----
# DREX_DAILY_CAP=3000        # Drex calls per day (UTC), then bots use the local brain. 0 = no cap
# LLM_DAILY_CAP=100          # LLM calls per day (benchmark LLM bot)
# RATE_LIMIT_PER_MIN=240     # API requests per minute per IP
# HEAVY_LIMIT_PER_HOUR=10    # arena / benchmark / evolution / NDI uploads per hour per IP
# ROOM_CREATE_LIMIT_PER_HOUR=20
# MAX_ROOMS=50
# DATA_DIR=/var/data         # where saved chips go (a persistent disk); default: the app folder
