# ---- Drex (required for live bots) ----
DREX_API_KEY=
DREX_URL=https://drex.nace.ai/v1/systemone
DREX_MODEL=drex-latest
DREX_PRICE_PER_M_INPUT=0.05
DREX_TIMEOUT=3

# ---- LLM "Giant" for the benchmark (either one) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# LLM_MODEL=claude-sonnet-5-5
# LLM_PRICE_IN=3.0
# LLM_PRICE_OUT=15.0

# ---- NDI (hand-history upload) ----
NDI_API_KEY=
# NDI_BASE_URL=https://ndi-api.nace.ai

# ---- tuning ----
MANIP_BLUFF_THRESHOLD=0.5
MC_RUNS=300
PORT=5050
